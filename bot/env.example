# Telegram Bot Token
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# Путь к файлу каскадного классификатора для детекции лиц
# Скачайте facefinder из https://github.com/esimov/pigo/tree/master/cascade
CASCADE_PATH=cascade/facefinder

# Минимальное количество лиц на фото для создания голосования
MIN_FACES=4

# Максимальное количество лиц на фото для создания голосования
MAX_FACES=6

# Текст голосования
VOTING_TEXT=кто тут у нас самый улыбчивый

# Длительность голосования (формат: 5m, 10m, 1h и т.д.)
VOTING_DURATION=5m
